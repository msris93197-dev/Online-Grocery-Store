<%-- Consistent titles, real parent breadcrumbs, back links and checkout progress. --%>
<%@ taglib uri="http://java.sun.com/jsp/jstl/core" prefix="c"%>
<nav class="app-breadcrumbs" aria-label="Breadcrumb"><ol><li><a href="${pageContext.request.contextPath}${param.rootUrl}"><c:out value="${param.root}"/></a></li><c:if test="${not empty param.parent}"><li><a href="${pageContext.request.contextPath}${param.parentUrl}"><c:out value="${param.parent}"/></a></li></c:if><li aria-current="page"><c:out value="${empty param.crumb ? param.title : param.crumb}"/></li></ol></nav>
<div class="app-page-header"><c:if test="${param.back == 'true'}"><a class="back-link" data-back href="${pageContext.request.contextPath}${param.parentUrl}">&#8592; Back</a></c:if><div><h1><c:out value="${param.title}"/></h1><c:if test="${not empty param.subtitle}"><p><c:out value="${param.subtitle}"/></p></c:if></div></div>
<c:if test="${not empty param.step}"><ol class="checkout-progress" aria-label="Checkout progress"><li class="${param.step == '1' ? 'current' : ''}" ${param.step == '1' ? 'aria-current="step"' : ''}><a href="${pageContext.request.contextPath}/cart/my-cart">1 <span>Cart</span></a></li><li class="${param.step == '2' ? 'current' : ''}" ${param.step == '2' ? 'aria-current="step"' : ''}><span>2 Address</span></li><li class="${param.step == '3' ? 'current' : ''}" ${param.step == '3' ? 'aria-current="step"' : ''}><span>3 Payment</span></li></ol></c:if>